{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SmartRender",
  "version": "0.1.0",
  "identifier": "com.smartrender.app",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "SmartRender — conversão inteligente GPU + CPU",
        "width": 1120,
        "height": 860,
        "minWidth": 760,
        "minHeight": 600,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
